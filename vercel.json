{
  "version": 2,
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "web/dist" }
    },
    {
      "src": "web/api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "^/api/(.*)", "dest": "/web/api/$1.js" },
    { "src": "/(.*)", "dest": "/web/dist/$1" }
  ]
}
